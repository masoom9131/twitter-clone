<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        /* Internal CSS for styling and animations */
        body {
            margin: 0;
            font-family: 'Arial', sans-serif;
            background: #f5f8fa;
            display: flex;
        }
        .sidebar {
            width: 250px;
            background: #1da1f2;
            padding: 1rem;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }
        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .sidebar a {
            display: block;
            padding: 10px 15px;
            margin-bottom: 10px;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s;
        }
        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.2);
        }
        .content {
            flex-grow: 1;
            padding: 2rem;
            overflow-y: auto;
        }
        .content h1 {
            color: #1da1f2;
            margin-bottom: 1rem;
        }
        .posts, .users, .profile {
            background: white;
            padding: 1rem;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        .post, .user {
            border-bottom: 1px solid #ccc;
            padding: 1rem 0;
        }
        .post:last-child, .user:last-child {
            border-bottom: none;
        }
        .post .actions, .user .actions {
            display: flex;
            justify-content: space-between;
            margin-top: 1rem;
        }
        .post button, .user button {
            background: #1da1f2;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }
        .post button:hover, .user button:hover {
            background: #0d95e8;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Admin Dashboard</h2>
        <a href="#" onclick="showSection('usersPosts')">Users Posts</a>
        <a href="#" onclick="showSection('manageUserPost')">Manage User Post</a>
        <a href="#" onclick="showSection('banUsers')">Ban Users</a>
        <a href="#" onclick="showSection('verifyUser')">Verify User</a>
    </div>
    <div class="content">
        <section id="usersPosts" class="section">
            <h1>Users Posts</h1>
            <%for(var i=0;i<posts.length;i++){ %>
            <div class="post">
                <div class="postU">
                    <p>@<%=postedby[i]%></p>
                    <p><%=posts[i]%></p>
                    <div class="actions">
                        <button type="submit">Edit</button>
                        <button type="submit">Delete</button>
                    </div>
                </div>
            <%}%>
        </section>
        <section id="manageUserPost" class="section" style="display:none;">
            <h1>Manage User Post</h1>
            <div class="posts">
                <div class="post">
                    <p>User Post 1: Lorem ipsum dolor sit amet.</p>
                    <div class="actions">
                        <button onclick="approvePost(this)">Approve</button>
                        <button onclick="rejectPost(this)">Reject</button>
                    </div>
                </div>
                <div class="post">
                    <p>User Post 2: Consectetur adipiscing elit.</p>
                    <div class="actions">
                        <button onclick="approvePost(this)">Approve</button>
                        <button onclick="rejectPost(this)">Reject</button>
                    </div>
                </div>
            </div>
        </section>
        <section id="banUsers" class="section" style="display:none;">
            <h1>Ban Users</h1>
            <div class="users">
                <div class="user">
                    <p>User 1: johndoe@example.com</p>
                    <div class="actions">
                        <button onclick="banUser(this)">Ban</button>
                        <button onclick="unbanUser(this)">Unban</button>
                    </div>
                </div>
                <div class="user">
                    <p>User 2: janedoe@example.com</p>
                    <div class="actions">
                        <button onclick="banUser(this)">Ban</button>
                        <button onclick="unbanUser(this)">Unban</button>
                    </div>
                </div>
            </div>
        </section>
        <section id="verifyUser" class="section" style="display:none;">
            <h1>Verify User</h1>
            <div class="users">
                <div class="user">
                    <p>User 1: johndoe@example.com</p>
                    <div class="actions">
                        <button type="submit">Verify</button>
                        <button type="submit">Unverify</button>
                    </div>
                </div>
                <div class="user">
                    <p>User 2: janedoe@example.com</p>
                    <div class="actions">
                        <button type="submit">Verify</button>
                        <button type="submit">Unverify</button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</body>
</html>
